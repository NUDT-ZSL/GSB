{
  "cache_dir": "run/cache",
  "snapshot_dir": "run/snapshots",
  "state_dir": "run/state",
  "limits": {
    "max_recompute_jobs": 64,
    "max_block_resident_bytes": 8388608,
    "max_parallel_nodes": 4
  },
  "tolerances": {
    "quant_input": 0.05,
    "fixed_point_mac": 1.0,
    "accumulator_reduce": 0.5,
    "dequant_output": 2.0
  }
}