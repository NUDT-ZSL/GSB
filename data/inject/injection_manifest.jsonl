{"case": "unknown_version", "expect": "E_FORMAT_VERSION_UNSUPPORTED", "file": "bad_version.txt", "kind": "format"}
{"case": "truncated_header", "expect": "E_FORMAT_CORRUPT", "file": "bad_header.txt", "kind": "format"}
{"case": "field_count", "expect": "E_FORMAT_CORRUPT", "file": "bad_fieldcount_v1.txt", "kind": "format"}
{"case": "missing_field", "expect": "E_FORMAT_CORRUPT", "file": "bad_missing_v2.txt", "kind": "format"}
{"case": "bad_number", "expect": "E_FORMAT_CORRUPT", "file": "bad_number_v2.txt", "kind": "format"}
{"case": "retired_label", "expect": "E_LABEL_RETIRED", "kind": "run", "vocab": 2}
{"case": "resource_limit", "expect": "E_RESOURCE_LIMIT", "kind": "run", "limits_file": "tight_limits.json", "vocab": 1}
