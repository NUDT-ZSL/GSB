{
  "schema_version": "1.0",
  "flops_per_second": 1800000000.0,
  "memory_bytes_per_second": 18000000000.0,
  "tile_overhead_seconds": 0.0000035,
  "task_overhead_seconds": 0.000025,
  "parallel_sync_seconds": 0.0000015,
  "cache_miss_penalty_scale": 0.00000012,
  "cache_pressure_exponent": 2.0,
  "nominal_parallel_workers": 4,
  "flatten_chunk_size": 16,
  "batch_parallel_min_batch": 4,
  "flatten_min_batch": 32,
  "formula": {
    "single_batch_elements": "M * N * K",
    "total_elements": "M * N * K * batch",
    "flops": "2 * M * N * K * batch",
    "padded_flops": "2 * ceil(M/BM)*BM * ceil(N/BN)*BN * ceil(K/BK)*BK * batch",
    "tile_count": "ceil(M/BM) * ceil(N/BN) * ceil(K/BK)",
    "memory_bytes": "4 * (batch*M*K + batch*K*N + batch*M*N)",
    "accumulator_elements": "ijk: BM*BN; ikj: BM*N; jik: M*BN",
    "working_set_bytes": "4 * (BM*BK + BK*BN + accumulator_elements)",
    "compute_seconds": "flops / flops_per_second",
    "memory_seconds": "memory_bytes / memory_bytes_per_second",
    "wasted_compute_seconds": "(padded_flops - flops) / flops_per_second",
    "tile_overhead_seconds": "tile_count * batch * tile_overhead_seconds",
    "cache_pressure": "max(0, working_set_bytes / cache_budget_bytes - 1)",
    "cache_penalty_seconds": "cache_pressure^cache_pressure_exponent * cache_miss_penalty_scale * flops / 1e6",
    "serial_schedule_seconds": "batch * task_overhead_seconds",
    "batch_parallel_schedule_seconds": "ceil(batch / nominal_parallel_workers) * task_overhead_seconds + batch * parallel_sync_seconds",
    "flattened_schedule_seconds": "ceil(batch / flatten_chunk_size) * task_overhead_seconds",
    "estimated_cost_seconds": "compute_seconds + memory_seconds + wasted_compute_seconds + tile_overhead_seconds + cache_penalty_seconds + schedule_seconds"
  }
}
