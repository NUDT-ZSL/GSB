{
  "name": "precision_propagation_demo",
  "seed": 20261123,
  "series": {
    "length": 320,
    "target": {
      "trend": 0.035,
      "cycles": [
        {"amplitude": 1.5, "period": 24.0, "phase": 0.2},
        {"amplitude": 0.45, "period": 7.0, "phase": 1.1}
      ],
      "noise_std": 0.08,
      "event_effects": {"promo": 0.9}
    },
    "exogenous": [
      {
        "name": "load",
        "seed": 41001,
        "trend": 0.002,
        "amplitude": 0.8,
        "period": 18.0,
        "phase": 0.4,
        "noise_std": 0.05
      },
      {
        "name": "temperature",
        "seed": 41002,
        "trend": -0.001,
        "amplitude": 0.6,
        "period": 31.0,
        "phase": 2.0,
        "noise_std": 0.04
      }
    ],
    "events": [
      {"name": "promo", "seed": 42001, "probability": 0.08}
    ]
  },
  "window": {
    "length": 16,
    "horizon": 4,
    "train_fraction": 0.72
  },
  "features": {
    "lags": [1, 2, 3, 4],
    "rolling": [
      {"stat": "mean", "window": 3},
      {"stat": "std", "window": 4}
    ],
    "differences": [1],
    "include_exogenous": true,
    "include_events": true,
    "standardize": true
  },
  "model": {
    "family": "linear_autoregressive",
    "epochs": 30,
    "learning_rate": 0.05,
    "l2": 0.0005,
    "confidence_z": 1.96,
    "stump_rounds": 12,
    "stump_learning_rate": 0.12,
    "stump_min_leaf": 4
  },
  "training": {
    "chunk_size": 8,
    "compensated_sum": true,
    "subnormal_guard": true,
    "reduction_order": "window_then_anchor"
  },
  "precision": {
    "profile": "float64",
    "fixed_scale": 1000000,
    "rounding": "nearest_even"
  },
  "evaluation": {
    "threshold": 0.6,
    "tolerance": 0.02,
    "threshold_strategy": "tolerance_band",
    "metrics": ["mae", "rmse", "mape", "smape", "max_abs_error"],
    "confidence_z": 1.96,
    "metric_epsilon": 1e-12
  },
  "snapshot": {
    "enabled": true,
    "directory": "reports/snapshots",
    "names": ["window_stats", "precision_config", "error_spectrum"],
    "version_mode": "auto",
    "versions": {}
  }
}
