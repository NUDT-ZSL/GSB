{
  "generator": {
    "token_length": 20,
    "sample_count": 20,
    "missing_probability": 0.4
  },
  "model": {
    "num_experts": 4,
    "top_k": 2,
    "token_feature_dim": 16,
    "initial_temperature": 8.0,
    "epochs": 4,
    "batch_size": 10,
    "capacity_factor": 1.2,
    "near_tie_margin": 0.02
  },
  "collapse": {
    "utilization_threshold": 0.1,
    "patience_steps": 2,
    "adjustment_strategy": "temperature",
    "temperature_multiplier": 1.0,
    "max_adjustments": 1
  }
}
