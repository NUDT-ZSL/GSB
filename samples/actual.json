{
  "apiVersion": "drift.local/v1",
  "kind": "ActualResourceList",
  "objects": [
    {
      "data": {
        "FEATURE_FLAG": "enabled",
        "LOG_LEVEL": "info",
        "TIMEOUT_MS": "5000"
      },
      "kind": "ConfigMap",
      "labels": {
        "app": "api",
        "managed-by": "sample-simulator"
      },
      "name": "api-config",
      "namespace": "shop"
    },
    {
      "data": {
        "FEATURE_FLAG": "enabled",
        "LOG_LEVEL": "info",
        "TIMEOUT_MS": "5000"
      },
      "kind": "ConfigMap",
      "labels": {
        "app": "legacy",
        "managed-by": "sample-simulator"
      },
      "name": "legacy-config",
      "namespace": "shop"
    },
    {
      "configMapRefs": [
        "api-config"
      ],
      "image": "registry.local/shop/api:1.3.0",
      "kind": "Deployment",
      "labels": {
        "app": "api",
        "team": "shop",
        "tier": "backend"
      },
      "name": "api",
      "namespace": "shop",
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "protocol": "TCP"
        }
      ],
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "api"
        }
      }
    },
    {
      "configMapRefs": [
        "legacy-config"
      ],
      "image": "registry.local/legacy/app:0.9.0",
      "kind": "Deployment",
      "labels": {
        "app": "legacy",
        "team": "shop",
        "tier": "backend"
      },
      "name": "legacy",
      "namespace": "shop",
      "ports": [
        {
          "name": "http",
          "port": 8080,
          "protocol": "TCP"
        }
      ],
      "replicas": 1,
      "selector": {
        "matchLabels": {
          "app": "legacy"
        }
      }
    },
    {
      "kind": "Service",
      "labels": {
        "app": "api",
        "tier": "frontend"
      },
      "name": "api-svc",
      "namespace": "shop",
      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "TCP",
          "targetPort": 8080
        }
      ],
      "selector": {
        "matchLabels": {
          "app": "api-v2"
        }
      }
    },
    {
      "kind": "Service",
      "labels": {
        "app": "legacy",
        "tier": "frontend"
      },
      "name": "legacy-svc",
      "namespace": "shop",
      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "TCP",
          "targetPort": 9000
        }
      ],
      "selector": {
        "matchLabels": {
          "app": "legacy"
        }
      }
    }
  ],
  "scenario": "small-mixed-drift"
}
