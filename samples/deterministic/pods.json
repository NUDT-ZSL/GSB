{
  "pods": [
    {
      "name": "db-primary",
      "priority": 100,
      "workload": "database",
      "labels": {
        "app": "db",
        "tier": "critical"
      },
      "resources": {
        "cpu_millicores": 500,
        "memory_mib": 512,
        "gpu": 1
      },
      "node_affinity": {
        "required": [
          {
            "key": "gpu",
            "operator": "In",
            "values": [
              "true"
            ]
          }
        ],
        "preferred": [
          {
            "key": "tier",
            "operator": "In",
            "values": [
              "fast"
            ],
            "weight": 2
          }
        ]
      },
      "topology_spread": [
        {
          "topology_key": "topology.kubernetes.io/zone",
          "max_skew": 1,
          "min_domains": 2,
          "when_unsatisfiable": "DoNotSchedule",
          "match_labels": {
            "app": "db"
          }
        }
      ]
    },
