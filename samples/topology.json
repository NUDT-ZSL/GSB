{
  "version": 1,
  "services": [
    {
      "name": "gateway",
      "instances": ["gateway-1", "gateway-2"],
      "priority": 10
    },
    {
      "name": "payments",
      "instances": ["payments-1"],
      "priority": 20
    },
    {
      "name": "batch",
      "instances": ["batch-1", "batch-2", "batch-3"],
      "priority": 30
    }
  ],
  "dependencies": [
    {"from": "gateway", "to": "payments"},
    {"from": "gateway", "to": "batch"}
  ]
}
