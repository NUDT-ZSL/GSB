{
  "objects": [
    {"kind": "upstream_member", "id": "m-a",
     "spec": {"host": "127.0.0.1", "port": 9101, "weight": 3}},
    {"kind": "upstream_member", "id": "m-b",
     "spec": {"host": "127.0.0.1", "port": 9102, "weight": 1}},
    {"kind": "upstream_member", "id": "m-c",
     "spec": {"host": "127.0.0.1", "port": 9103, "weight": 1}},
    {"kind": "upstream_member", "id": "s-a",
     "spec": {"host": "127.0.0.1", "port": 9111, "weight": 1}},
    {"kind": "upstream_group", "id": "g-prod",
     "spec": {"member_ids": ["m-a", "m-b"], "lb": "weighted"}},
    {"kind": "upstream_group", "id": "g-extra",
     "spec": {"member_ids": ["m-c"], "lb": "weighted"}},
    {"kind": "upstream_group", "id": "g-shadow",
     "spec": {"member_ids": ["s-a"], "lb": "weighted"}},
    {"kind": "mirror_policy", "id": "mp-main",
     "spec": {"shadow_upstream_group_id": "g-shadow", "percent": 100,
              "async": true, "drop_response": true}},
    {"kind": "gray_route", "id": "r-canary",
     "spec": {"upstream_group_id": "g-prod", "weight": 1, "gray_percent": 25,
              "matches": [{"headers": {"x-gray": "canary"}}],
              "mirror_policy_id": null}},
    {"kind": "gray_route", "id": "r-extra",
     "spec": {"upstream_group_id": "g-extra", "weight": 1, "gray_percent": 0,
              "matches": [{"headers": {"x-api": "extra"}}],
              "mirror_policy_id": null}},
    {"kind": "gray_route", "id": "r-stable",
     "spec": {"upstream_group_id": "g-prod", "weight": 1, "gray_percent": 75,
              "matches": [], "mirror_policy_id": "mp-main"}},
    {"kind": "virtual_service", "id": "vs-main",
     "spec": {"name": "main", "hosts": ["demo.local"],
              "route_ids": ["r-canary", "r-extra", "r-stable"]}}
  ]
}
