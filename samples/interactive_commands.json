{
  "base_config": "samples/t2v.json",
  "commands": [
    {
      "id": "prompt-change",
      "preview_budget_ms": 20,
      "set": {
        "prompt": "a blue bird flies over a calm lake at dawn"
      }
    },
    {
      "delay_before_ms": 800,
      "id": "seed-change",
      "preview_budget_ms": 20,
      "set": {
        "seed": 2026
      }
    },
    {
      "id": "guidance-change",
      "preview_budget_ms": 20,
      "set": {
        "guidance": 2.75
      }
    },
    {
      "id": "frame-count-change",
      "preview_budget_ms": 20,
      "set": {
        "frames": 3
      }
    },
    {
      "id": "step-count-change",
      "preview_budget_ms": 20,
      "set": {
        "noise_table_path": "samples/noise_table_3.npy",
        "steps": 3
      }
    },
    {
      "id": "switch-to-i2v",
      "preview_budget_ms": 20,
      "set": {
        "i2v_replacement_steps": 1,
        "init_image_path": "samples/init_image.png",
        "mode": "i2v"
      }
    },
    {
      "id": "apply-patch",
      "preview_budget_ms": 20,
      "set": {
        "patch": {
          "frame": 1,
          "step": 1,
          "values": [
            [
              [
                0.25,
                -0.15,
                0.4,
                0.05
              ],
              [
                0.35,
                -0.05,
                0.3,
                0.15
              ]
            ],
            [
              [
                0.45,
                0.05,
                0.2,
                0.25
              ],
              [
                0.55,
                0.15,
                0.1,
                0.35
              ]
            ]
          ],
          "x": 1,
          "y": 2
        }
      }
    },
    {
      "id": "remove-patch",
      "preview_budget_ms": 20,
      "set": {
        "patch": null
      }
    },
    {
      "id": "restore-step-count",
      "preview_budget_ms": 20,
      "set": {
        "noise_table_path": "samples/noise_table_4.npy",
        "steps": 4
      }
    }
  ],
  "version": 1
}
