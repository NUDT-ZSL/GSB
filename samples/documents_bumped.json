  "doc-002": {
    "category": "incremental",
    "doc_id": "doc-002",
    "doc_len": 23,
    "doc_version": 2,
    "paragraphs": [
      {
        "role": "definition",
        "text": "incremental invalidation 在 document version 提升后只重算受影响 recall 与 snippet，未变化文档继续复用内容寻址产物。"
      },
      {
        "role": "mechanism",
        "text": "publish 事件会改变词项与向量得分，已经缓存的正常词项阶段仍可复用；受影响文档必须重新抽取片段。"
      },
      {
        "role": "caveat",
        "text": "删除文档后必须从 recall 集合移除它，并让 citation 装配与答案合成从受影响后缀重新计算。"
      },
      {
        "role": "example",
        "text": "局部 invalidation 的结果必须与使用新文档集合从零完整 recompute 的规范化字节完全一致。"
      }
    ],
