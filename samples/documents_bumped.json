  "doc-003": {
    "category": "snapshot",
    "doc_id": "doc-003",
    "doc_len": 29,
    "doc_version": 1,
    "paragraphs": [
      {
        "role": "definition",
        "text": "snapshot 使用单调递增 version 和覆盖 envelope 的 checksum，引用与答案总是整体替换而不是局部修补。"
      },
      {
        "role": "mechanism",
        "text": "写入同一 cache key 时通过非阻塞独占锁控制并发，失败方立即收到 stage busy，不允许无限等待。"
      },
      {
        "role": "caveat",
        "text": "回退写入触发 snapshot rollback；内容损坏或 checksum 不符触发 snapshot corrupt，两类错误必须区分。"
      },
      {
        "role": "example",
        "text": "文档版本表、引用快照和答案快照分别具有版本号，读取时先验证 envelope 再解析业务内容。"
      }
    ],
