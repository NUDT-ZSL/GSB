    "doc_len": 28,
    "doc_version": 1,
    "paragraphs": [
      {
        "role": "definition",
        "text": "query normalization 使用 Unicode NFKC 与 casefold，再合并同一 session 的前序轮次形成 context。"
      },
      {
        "role": "mechanism",
        "text": "上下文词项按轮次衰减合并，locale 与 session hint 保留当前轮，token 顺序始终显式排序。"
      },
      {
        "role": "caveat",
        "text": "归一化结果禁止依赖字典遍历顺序，候选集合与路名归属必须经过规范化序列化后比较。"
      },
      {
        "role": "example",
        "text": "相同 conversational query 在多轮 context merge 后产生稳定的 recall 输入与查询哈希。"
      }
    ],
