    "category": "citation",
    "doc_id": "doc-001",
    "doc_len": 50,
    "doc_version": 1,
    "paragraphs": [
      {
        "role": "definition",
        "text": "v1 citation 使用 doc_id、start、end 与 score 四个竖线字段，span 按 Unicode 码点计数，不包含 paragraph role 或 confidence 区间。"
      },
      {
        "role": "mechanism",
        "text": "v2 在 v1 的四字段后补充 confidence low、confidence high、paragraph role 与 order weight，从而保留排序权重和段落语义。"
      },
      {
        "role": "caveat",
        "text": "跨格式加载时必须逐项比较 citation span，任何 offset 改写或截断都会触发 span drift，不能以字符串截断掩盖错误。"
      },
      {
        "role": "example",
        "text": "当 v3 citation 带有 context chain 与 revision 时，降级到 v1 需要显式记录被丢弃的多轮上下文引用链。"
      }
    ],
