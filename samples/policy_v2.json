{
  "schema_version": 1,
  "policy_version": "policy-v2",
  "key_fields": [
    "path",
    "tenant",
    "encoding"
  ],
  "ttl_seconds_by_path": {
    "/index.html": 15,
    "/assets/base.css": 20,
    "/assets/theme.css": 10,
    "/assets/app.css": 25,
    "/assets/app.manifest.json": 30
  },
  "node_capacity": 2,
  "eviction_rule": "fifo"
}

