{
  "baselines": [
    {
      "effective_from_seq": 1,
      "effective_to_seq": 100,
      "host_id": "host-alpha",
      "path": "service.port",
      "ranges": [
        {
          "interval": "[8000,8100)",
          "source": "range-service-main"
        }
      ],
      "source": "policy-service-v1"
    },
    {
      "effective_from_seq": 1,
      "effective_to_seq": 100,
