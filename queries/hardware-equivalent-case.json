{
  "LIMIT": 3,
  "Sort": [
    {"PATH": "price", "DIRECTION": "DESC"},
    {"path": "id", "dir": "Asc"}
  ],
  "projection": ["stock.quantity", "category", "price", "name", "id"],
  "filter": {
    "OP": "AND",
    "ARGS": [
      {"op": "GTE", "path": "price", "value": 20.0},
