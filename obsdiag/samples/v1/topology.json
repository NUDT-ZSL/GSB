{
  "version": 1,
  "services": [
    "gateway",
    "order",
    "payment",
    "inventory",
    "notify",
    "payment-db",
    "inventory-db"
  ],
  "edges": [
    {"source": "gateway", "target": "order", "weight": 1},
    {"source": "order", "target": "payment", "weight": 2},
